generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Appliances {
  TV
  Projector
  Fan
}

model Room {
  id                   String       @id @default(cuid())
  room_name            String       @unique
  location             String
  capacity             Int
  createdAt            DateTime     @default(now())
  image_url            String?
  image_public_id      String?
  available_appliances Appliances[]

  reservations  Reservation[]
  notifications Notification[]

  @@map("rooms")
}

model Reservation {
  id              String    @id @default(cuid())
  roomId          String
  userId          String // Reservation Creator
  reservationDate DateTime  @default(now())
  startTime       DateTime
  endTime         DateTime
  occupants       String[]
  purpose         String    @db.Text
  checkedInAt     DateTime?
  checkedOutAt    DateTime?

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  notifications Notification[]

  @@index([roomId, reservationDate])
  @@map("reservations")
}

model StudentRecord {
  id_number  String  @id
  firstname  String
  middlename String?
  lastname   String
  yearlevel  Int
  college    String
  program    String
}

enum NotificationType {
  CHECKED_IN
  CHECKED_OUT
  OTHER
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  message String

  reservationId String?
  roomId        String?

  user           User         @relation(fields: [userId], references: [id])
  reservationRef Reservation? @relation(fields: [reservationId], references: [id])
  roomRef        Room?        @relation(fields: [roomId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  name       String?
  password   String?
  role       Role      @default(STUDENT)
  disabledAt DateTime?

  notifications Notification[]
  reservations  Reservation[]

  @@index([role])
  @@map("users")
}

enum Role {
  ADMIN
  STUDENT
  STAFF
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
